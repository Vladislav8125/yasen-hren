// Схема — plans/2026-07-25-yasen-hren-tz-architecture.md, раздел 3.
// Это чертёж, перенесённый в реальный файл: сущности и связи полностью
// повторяют согласованное архитектурное ТЗ (7 разделов, все решения владельца учтены).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// --- перечисления ---

enum Tariff {
  FREE
  STANDARD
  PREMIUM
}

enum CardFamily {
  LIGHT // Светлая Семья
  SHADOW // Семья Теней
  LIMINAL // Пограничные
  PATH // Путь Путника (стадии развития — отдельный трек, не в ежедневной раздаче)
}

enum LifeSphere {
  HEALTH // Здоровье
  RELATIONS // Отношения
  BUSINESS // Бизнес
  HARMONY // Гармония
}

enum DeliveryChannel {
  WEB
  TELEGRAM
  VK
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum ConsultationStatus {
  REQUESTED // подписчик запросил слот
  SCHEDULED // основатель назначил время, ссылка на звонок известна
  COMPLETED
  CANCELLED
}

// Магазин — редизайн 2026-07-26, Фаза D (plans/2026-07-26-yasen-hren-redesign-light-cabinet.md).
// 4 позиции жёстко заданы в коде (src/lib/shop.ts), не в БД — не нужна
// отдельная CMS ради четырёх товаров.
enum ShopProductId {
  CARDS
  GAME
  CONSULTATION
  CORPORATE
  FOUNDER
  CHALLENGE
  MERCH
}

enum ShopOrderStatus {
  REQUESTED
  CONTACTED
  COMPLETED
  CANCELLED
}

enum PartnerStatus {
  ACTIVE
  PAUSED
}

enum PartnerRequestType {
  SPEAKING
  EVENT_GAME
  MEDIA
}

enum PartnerRequestStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

enum CommissionKind {
  SUBSCRIPTION
  CARDS
  CONSULTATION
  GAME
  MERCH
}

enum CommissionStatus {
  APPROVED
  PAID
  VOID
}

// --- модели ---

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  phone            String?         @unique
  name             String
  passwordHash     String
  role             UserRole        @default(USER)
  tariff           Tariff          @default(FREE)
  tariffExpiresAt  DateTime?
  preferredChannel DeliveryChannel @default(WEB)
  telegramChatId   String?         @unique
  vkUserId         String?         @unique
  referralAttribution ReferralAttribution?
  partner          Partner?
  referralCommissions ReferralCommission[] @relation("CommissionCustomer")
  createdAt        DateTime        @default(now())

  draws               DailyDraw[]
  payments            Payment[]
  consultations       Consultation[]
  shopOrders          ShopOrder[]
  glossarySubmissions GlossaryTerm[] @relation("submittedBy")
  glossaryModerations GlossaryTerm[] @relation("moderatedBy")

  // Реферальная программа — будущая фаза, НЕ в MVP (архитектурное ТЗ, раздел 11).
  // Поля-задел, закомментированы до запуска фазы:
  // referralCode         String  @unique
  // referredById         String?
  // referralBonusGranted Boolean @default(false)
}

model Partner {
  id              String        @id @default(cuid())
  userId          String        @unique
  code            String        @unique
  promoCode       String        @unique
  status          PartnerStatus @default(ACTIVE)
  payoutDetails   String?
  createdAt       DateTime      @default(now())

  user            User                    @relation(fields: [userId], references: [id])
  clicks          ReferralClick[]
  attributions    ReferralAttribution[]
  commissions     ReferralCommission[]
}

model ReferralClick {
  id          String   @id @default(cuid())
  partnerId   String
  targetPath  String   @default("/")
  referer     String?
  createdAt   DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([partnerId, createdAt])
}

model ReferralAttribution {
  id         String   @id @default(cuid())
  userId     String   @unique
  partnerId  String
  source     String   // link / promo
  expiresAt  DateTime
  lastClickAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([partnerId, expiresAt])
}

model ReferralCommission {
  id             String           @id @default(cuid())
  partnerId      String
  customerId     String
  paymentId      String?          @unique
  shopOrderId    String?          @unique
  kind           CommissionKind
  baseAmount     Int              // копейки
  rateBps        Int              // 2000 = 20%, 1000 = 10%
  amount         Int              // копейки
  status         CommissionStatus @default(APPROVED)
  paidAt         DateTime?
  createdAt      DateTime         @default(now())

  partner Partner @relation(fields: [partnerId], references: [id])
  customer User   @relation("CommissionCustomer", fields: [customerId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])
  shopOrder ShopOrder? @relation(fields: [shopOrderId], references: [id])

  @@index([partnerId, status, createdAt])
}

model PartnerRequest {
  id        String               @id @default(cuid())
  type      PartnerRequestType
  status    PartnerRequestStatus @default(NEW)
  name      String
  email     String
  company   String?
  message   String
  createdAt DateTime             @default(now())
}

model Archetype {
  id           String     @id @default(cuid())
  family       CardFamily
  name         String     @unique // "БАБАЙ" — уникально, чтобы seed-скрипт мог делать upsert
  tagline      String // "Пока не назовёшь — буду везде..."

  // Видно на ЛЮБОМ тарифе, включая Free — полный текст физической карты
  // (решение владельца 2026-07-25: Free = «карта со всеми надписями, как в файле колоды»)
  // Опциональны — не на каждой физической карте печатаются оба поля
  // (например, у части Пограничных нет отдельной строки «АРХЕТИП»).
  property      String? // СВОЙСТВО
  archetypeType String? // АРХЕТИП
  essence       String // СУТЬ
  function      String? // ФУНКЦИЯ
  inLife        String? // В ЖИЗНИ
  ritual        String? // РИТУАЛ
  cardQuestion  String? // ВОПРОС КАРТЫ
  clinicalFlag  String? // ⚠ показывается ВСЕГДА, вне зависимости от тарифа
  branch        String? // ВЕТВЬ РОДА (только Светлая Семья)
  shadowSide    String? // ТЕНЬ (печатается на части светлых/пограничных карт — не путать с family=SHADOW)

  // Поля карт «Путь Путника» (family=PATH) — другая структура печатной карты,
  // 2-колоночная инфографика вместо стандартных полей выше (дизайн-ТЗ, 3.1).
  pathFunctions      String? // ФУНКЦИИ
  pathResources      String? // РЕСУРСЫ
  pathRituals        String? // РИТУАЛЫ
  pathShadows        String? // ТЕНИ (список проявлений)
  pathMotto          String? // ДЕВИЗ
  pathManifestations String? // ПРОЯВЛЕНИЯ

  // НОВЫЙ текст, которого нет на физической карте. Виден со Standard и выше.
  extendedDescription String? // «Развёрнутое описание»
  usageInstruction    String? // «Инструкция как пользоваться»

  lightAllyId   String? // связь тень → светлый союзник (по id)
  lightAllyName String? // имя союзника, если он ещё не создан на момент сидирования — резолвится во втором проходе
  imageUrl      String?
  spheres       LifeSphere[] // к каким сферам жизни привязана карта

  lightAlly       Archetype?  @relation("Ally", fields: [lightAllyId], references: [id])
  shadowOf        Archetype[] @relation("Ally")
  primaryDraws    DailyDraw[] @relation("PrimaryDraw")
  secondaryDraws  DailyDraw[] @relation("SecondaryDraw")
  pathDraws       DailyDraw[] @relation("PathDraw")
}

model DailyDraw {
  id                   String          @id @default(cuid())
  userId               String
  date                 DateTime        @db.Date // 1 запись на пользователя в день
  primaryArchetypeId   String
  secondaryArchetypeId String? // 2-я карта — только Premium
  pathArchetypeId      String? // Карта Путника — раз в 7 дней (Standard+/Free — paywall)
  sphereRequested      LifeSphere? // если выбор был по сфере, а не рандом
  channel              DeliveryChannel // откуда была открыта карта
  createdAt            DateTime        @default(now())

  user               User       @relation(fields: [userId], references: [id])
  primaryArchetype   Archetype  @relation("PrimaryDraw", fields: [primaryArchetypeId], references: [id])
  secondaryArchetype Archetype? @relation("SecondaryDraw", fields: [secondaryArchetypeId], references: [id])
  pathArchetype      Archetype? @relation("PathDraw", fields: [pathArchetypeId], references: [id])

  @@unique([userId, date]) // гарантия «1 карта дня на пользователя»
}

model Payment {
  id                String    @id @default(cuid())
  userId            String
  tariff            Tariff
  amount            Int // в копейках
  status            String // pending / succeeded / canceled
  yookassaPaymentId String?   @unique
  createdAt         DateTime  @default(now())
  paidAt            DateTime?

  user User @relation(fields: [userId], references: [id])
  referralCommission ReferralCommission?
}

model Consultation {
  id          String             @id @default(cuid())
  userId      String
  status      ConsultationStatus @default(REQUESTED)
  periodMonth String // "2026-08" — ограничение 1 консультация/месяц
  scheduledAt DateTime?
  meetingLink String? // ссылка на звонок — назначает основатель вручную в MVP
  createdAt   DateTime           @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, periodMonth]) // гарантия «не больше 1 консультации в месяц на подписчика»
}

model Psychologist {
  id          String   @id @default(cuid())
  name        String
  credentials String // регалии/специализация — плейсхолдер-профили до реальных данных от владельца
  photoUrl    String?
  createdAt   DateTime @default(now())

  orders ShopOrder[]
}

model ShopOrder {
  id             String          @id @default(cuid())
  userId         String
  product        ShopProductId
  status         ShopOrderStatus @default(REQUESTED)
  psychologistId String? // только для product=CONSULTATION
  createdAt      DateTime        @default(now())

  user         User          @relation(fields: [userId], references: [id])
  psychologist Psychologist? @relation(fields: [psychologistId], references: [id])
  referralCommission ReferralCommission?
}

model GlossaryTerm {
  id            String   @id @default(cuid())
  term          String
  definition    String
  status        String   @default("pending") // pending / approved / rejected
  submittedById String
  moderatedById String?
  createdAt     DateTime @default(now())

  submittedBy User  @relation("submittedBy", fields: [submittedById], references: [id])
  moderatedBy User? @relation("moderatedBy", fields: [moderatedById], references: [id])
}

// для RAG-ассистента — эмбеддинги источников (методология, статьи, глоссарий)
model KnowledgeChunk {
  id         String                       @id @default(cuid())
  sourceType String // "methodology" | "glossary" | "card"
  sourceId   String? // id термина/карты, если применимо
  content    String
  // 1024 — дефолтный output_dimension у Voyage AI (сейчас voyage-4, см.
  // src/lib/embeddings.ts). Если модель/dimension сменится — размерность
  // здесь и в src/lib/embeddings.ts должны совпадать, иначе pgvector
  // откажется писать строки.
  embedding  Unsupported("vector(1024)")?
}
