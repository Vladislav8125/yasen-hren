# Скопируйте в .env и заполните реальными значениями.
# .env в git не попадает (см. .gitignore) — не бойтесь коммитить .env.example.

# База данных (архитектурное ТЗ, раздел 1: старт на управляемой Postgres —
# Vercel Postgres / Neon / Supabase, позже перенос на VPS Timeweb).
#
# Для локальной разработки без реального аккаунта — встроенный локальный
# Postgres от Prisma: `pnpm prisma dev --name yasen-hren --detach` печатает
# готовую строку подключения, её и нужно подставить сюда.
DATABASE_URL="postgresql://user:password@localhost:5432/yasen_hren?schema=public"

# ЮKassa (архитектурное ТЗ, раздел 8) — ключей ещё нет, магазин не зарегистрирован
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# OpenRouter — комплишн для RAG-ассистента, режим смыслового ответа
# (архитектурное ТЗ, раздел 7). Ключ: https://openrouter.ai/keys
# OPENROUTER_MODEL — необязательно, по умолчанию "anthropic/claude-sonnet-5".
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-sonnet-5"

# Voyage AI — эмбеддинги для семантического поиска (нужен отдельно от
# OpenRouter — эмбеддинги не проходят через него). Без него работает
# только дословный режим ассистента, поиск по смыслу отключён.
# Ключ: https://dash.voyageai.com — при регистрации создаётся сразу.
# voyage-4 — 200 млн бесплатных токенов на аккаунт (проверено 2026-07-26;
# voyage-3.5 устарела и бесплатного лимита уже не даёт — не переключайте на неё).
# После получения ключа — проиндексировать базу: `pnpm tsx prisma/ingest-knowledge.ts`
VOYAGE_API_KEY=""
VOYAGE_EMBEDDING_MODEL="voyage-4"

# NextAuth.js / Auth.js (архитектурное ТЗ, раздел 1) — Фаза 2 (auth).
# Сгенерировать: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
AUTH_SECRET=""

# Адрес приложения — нужен для return_url ЮKassa (куда вернуть пользователя
# после оплаты) и для webhook Telegram/VK. На проде — реальный домен.
APP_URL="http://localhost:3000"

# Telegram-бот (архитектурное ТЗ, раздел 10) — токен от @BotFather, Фаза 9.
# Username нужен отдельно для ссылки привязки (t.me/<username>) — чтобы не
# дёргать Telegram API (getMe) на каждый рендер личного кабинета.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# VK-бот (архитектурное ТЗ, раздел 10) — Фаза 10.
# VK_GROUP_TOKEN — токен сообщества с правом "Сообщения сообщества" (Управление → Работа с API → Ключи доступа).
# VK_GROUP_ID — числовой id сообщества (без минуса), нужен для ссылки привязки vk.com/im?sel=-<id>.
# VK_CONFIRMATION_CODE — строка, которую VK покажет при включении Callback API
#   (Управление → Настройки → Работа с API → Callback API) — вернуть её дословно на "confirmation".
# VK_CALLBACK_SECRET — необязательный секретный ключ Callback API (та же вкладка) для проверки, что запрос от VK.
VK_GROUP_TOKEN=""
VK_GROUP_ID=""
VK_CONFIRMATION_CODE=""
VK_CALLBACK_SECRET=""
