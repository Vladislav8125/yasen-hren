# Скопируйте в .env и заполните реальными значениями.
# .env в git не попадает (см. .gitignore) — не бойтесь коммитить .env.example.

# База данных (архитектурное ТЗ, раздел 1: старт на управляемой Postgres —
# Vercel Postgres / Neon / Supabase, позже перенос на VPS Timeweb).
#
# Для локальной разработки без реального аккаунта — встроенный локальный
# Postgres от Prisma: `pnpm prisma dev --name yasen-hren --detach` печатает
# готовую строку подключения, её и нужно подставить сюда.
DATABASE_URL="postgresql://user:password@localhost:5432/yasen_hren?schema=public"

# ЮKassa (архитектурное ТЗ, раздел 8) — ключей ещё нет, магазин не зарегистрирован
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# Anthropic API — для RAG-ассистента (архитектурное ТЗ, раздел 7)
ANTHROPIC_API_KEY=""

# NextAuth.js / Auth.js (архитектурное ТЗ, раздел 1) — Фаза 2 (auth).
# Сгенерировать: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
AUTH_SECRET=""

# Адрес приложения — нужен для return_url ЮKassa (куда вернуть пользователя
# после оплаты) и для webhook Telegram/VK. На проде — реальный домен.
APP_URL="http://localhost:3000"

# Telegram-бот (архитектурное ТЗ, раздел 10) — токен от @BotFather, Фаза 9
TELEGRAM_BOT_TOKEN=""

# VK-бот (архитектурное ТЗ, раздел 10) — токен сообщества и id группы, Фаза 10
VK_GROUP_TOKEN=""
VK_GROUP_ID=""
